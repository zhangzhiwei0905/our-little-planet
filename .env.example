# 签名密钥：随机长字符串。生成一次就别换（换了所有人要重新解锁，改了它要重新 build）
AUTH_SECRET=change-me-to-a-long-random-string

# 解开手账的密码（给她的那个，建议用你们的纪念日，如 0520）
READER_PASSWORD=0520

# 作者口令（你自己记内容用，别告诉她）
AUTHOR_PASSWORD=write-for-her

# 作者会话几小时后过期（过期要重新输作者口令；登录时勾「这台设备是我自己的」则 30 天免输）。
# 防止在别人手机上登录过后台、权限一直挂着。留空默认 6 小时
AUTHOR_SESSION_HOURS=

# 界面上对读者的称呼：「仅她可见」「她的专属入口」……改成对方的昵称（改了要重新 build）。留空默认「她」
NEXT_PUBLIC_READER_NAME=

# iPhone 快捷指令速记通道（/api/quick）的令牌：openssl rand -hex 24 生成。留空则通道关闭
SHORTCUT_TOKEN=

# ffmpeg 可执行文件路径（读视频/录音的时长、抽视频封面用）。留空则用系统 PATH 里的 ffmpeg
FFMPEG_PATH=

# ── 演示模式（公开演示站用；正常部署留空即可，见 deploy/DEMO.md）──
# 设为 1：整本手账跑在内存里、定时重置回 npm run seed 的内容，任何保存都不落盘；
# 上传的照片/视频/实况/语音一律换成内置样例素材（改了要重新 build）
NEXT_PUBLIC_DEMO_MODE=
# 演示站多少分钟自动重置一次（留空默认 5）
DEMO_RESET_MINUTES=

# ── 阿里云 OSS（可选；四项都填了就自动切换到 OSS 直传模式，留空则存本地 data/media）──
# Bucket 名（建议私有读写）
OSS_BUCKET=
# 地域 Endpoint，如 oss-cn-hangzhou.aliyuncs.com（不带 bucket 前缀、不带 https://）
OSS_ENDPOINT=
# RAM 子账号 AccessKey（只授予这个 bucket 的 oss:PutObject/GetObject/DeleteObject 权限，别用主账号 AK）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
