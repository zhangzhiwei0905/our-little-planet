# 我们的小星球 · 演示站 Nginx 配置示例
# 部署步骤见同目录 DEMO.md；把 demo.example.com 换成你的子域名，
# 证书用 certbot --nginx -d demo.example.com 自动签发
limit_req_zone $demo_write_key zone=demo_write:10m rate=15r/m;

# 只对写接口限速：读页面不受影响（空 key = 不限）
map $request_method $demo_write_key {
    POST     $binary_remote_addr;
    PUT      $binary_remote_addr;
    PATCH    $binary_remote_addr;
    DELETE   $binary_remote_addr;
    default  "";
}

server {
    server_name demo.example.com;

    # 演示站上传都换样例素材，没必要放大口子；速记 multipart 表单也够用
    client_max_body_size 12m;

    location /api/ {
        limit_req zone=demo_write burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/demo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = demo.example.com) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name demo.example.com;
    return 404;
}
