# 我们的小星球 · 演示站 Nginx 配置（初始 HTTP 版）
#
# 顺序很重要：这份配置先不含任何 ssl 行——证书还没签的时候写了 ssl_certificate，
# nginx -t 会直接失败。正确流程：
#   1. 装好这份 conf → nginx -t && reload      （此时 http://域名 已可访问）
#   2. sudo certbot --nginx -d demo.example.com （certbot 自动签发证书、加上
#      443 监听和 80→443 跳转，之后 https://域名 即可用）
# 把 demo.example.com 换成你的子域名。
limit_req_zone $demo_write_key zone=demo_write:10m rate=15r/m;

# 只对写接口限速：读页面不受影响（空 key = 不限）
map $request_method $demo_write_key {
    POST     $binary_remote_addr;
    PUT      $binary_remote_addr;
    PATCH    $binary_remote_addr;
    DELETE   $binary_remote_addr;
    default  "";
}

server {
    listen 80;
    server_name demo.example.com;

    # 独立访问日志：统计演示站 PV/UV 用（logrotate 随 /var/log/nginx/*.log 自动轮转）
    access_log /var/log/nginx/journal-demo.access.log;

    # 演示站上传都换样例素材，没必要放大口子；速记 multipart 表单也够用
    client_max_body_size 12m;

    location /api/ {
        limit_req zone=demo_write burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
