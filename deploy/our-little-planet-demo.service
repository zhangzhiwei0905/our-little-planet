# 我们的小星球 · 演示站 systemd 服务
# 安装：sudo cp deploy/our-little-planet-demo.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now our-little-planet-demo
# 路径 / 用户 / 端口按实际情况修改；端口要和 nginx 配置里的 proxy_pass 一致

[Unit]
Description=our-little-planet demo (公开演示站，内存沙箱)
After=network.target

[Service]
Type=simple
# 建议用低权限用户跑；目录属主改成同一个
User=www-data
Group=www-data
WorkingDirectory=/opt/our-little-planet-demo
# .env.local 里写着 NEXT_PUBLIC_DEMO_MODE=1 / DEMO_RESET_MINUTES / 演示密码等
EnvironmentFile=/opt/our-little-planet-demo/.env.local
Environment=NODE_ENV=production
Environment=PORT=3100
# npm 的绝对路径用 which npm 查（nvm 装的话在 ~/.nvm/versions/... 下）
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
